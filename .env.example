# Copy to .env and adjust before running `docker compose up`.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Hostnames the app is served under (comma separated), and matching origins for CSRF (Django admin login)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# First HR admin, created on startup if it doesn't exist yet
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me

# Host port for the web app
HRIS_PORT=8080
